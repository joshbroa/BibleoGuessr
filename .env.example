# Copy to .env.local and fill in from the Firebase console
# (Project settings -> Your apps -> SDK setup and configuration).
#
# These values are public by design: they identify the project, they do not
# authorise anything. Authorisation is enforced by firestore.rules and by the
# Cloud Functions in functions/.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional. Set to "true" to point the SDK at the local emulator suite
# (Firestore on 8088, Auth on 9099, Functions on 5001) instead of the real
# project. Leave unset for normal development against Firebase.
# VITE_USE_EMULATORS=true
