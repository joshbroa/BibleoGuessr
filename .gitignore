# Secrets — any .env at any depth, so functions/.env is covered too.
# The .example templates carry no values and are deliberately tracked.
.env
.env.local
.env*.local
!.env.example

# Dependencies
node_modules/
functions/node_modules/

# Build output
dist/
.vite/

# Generated Bible page data (~40MB, rebuild with `npm run pages`)
public/bible_pages/
functions/src/bible_pages/
functions/src/verse_pool.json

# Firebase
.firebase/
firebase-debug.log
firebase-debug.*.log
firestore-debug.log
ui-debug.log
*.log

# Raw downloaded asset packs. Only the files actually used are copied into
# public/, with credits; the packs themselves stay out of the repository.
sounds_downloads/
