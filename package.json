{
  "name": "bibleoguessr",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "firebase emulators:exec --ui \"vite --mode emulator\"",
    "dev:live": "vite",
    "build": "vite build",
    "vercel-build": "node scripts/run-pages.mjs --if-missing && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "pages": "node scripts/run-pages.mjs",
    "emulators": "firebase emulators:start",
    "deploy": "npm run pages && npm run build && firebase deploy",
    "deploy:hosting": "npm run build && firebase deploy --only hosting",
    "deploy:functions": "npm run pages && firebase deploy --only functions",
    "deploy:rules": "firebase deploy --only firestore:rules,firestore:indexes"
  },
  "dependencies": {
    "@fontsource/overpass": "^5.3.0",
    "@react-three/drei": "^10.0.0",
    "@react-three/fiber": "^9.0.0",
    "firebase": "^11.0.0",
    "gsap": "^3.12.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.4.0",
    "@testing-library/react": "^16.1.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.20",
    "jsdom": "^25.0.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "vite": "^6.4.5",
    "vitest": "^5.1.0"
  }
}
